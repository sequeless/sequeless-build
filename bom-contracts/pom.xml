<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- No <parent>: this module is test-only and never released, and a parent link would couple it to
       sequeless-build-parent's release version (release PR #1 bumped the parent but not this module).
       The build conventions the parent provides are repeated below. Keep them in step with
       sequeless-build-parent/pom.xml. -->
  <groupId>org.sequeless</groupId>
  <artifactId>bom-contracts</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>BOM contracts</name>
  <description>Test-only module. Runs every testkit contract against the BOM's versions before a BOM
    release. Never deployed.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
    <junit-bom.version>6.1.3</junit-bom.version>
    <assertj-core.version>3.27.7</assertj-core.version>

    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
    <maven-enforcer-plugin.version>3.7.0</maven-enforcer-plugin.version>
    <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
    <spotless.version>3.12.0</spotless.version>
    <palantir-java-format.version>2.102.0</palantir-java-format.version>
  </properties>

  <!-- The sequeless-bom import is pinned to a released version, never a SNAPSHOT: importing
       0.1.0-SNAPSHOT broke the BOM release PR, which sets the BOM to 0.1.0. The expression contract
       (ExpressionBomContractTest, prototype spec 9, #37) is the first testkit contract this module
       runs against it, so the import returns here (#17, section 6). Bump it when the BOM is released. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>sequeless-bom</artifactId>
        <version>0.1.6</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj-core.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>automation-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>automation-contract</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>automation-inprocess-adapter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>automation-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>expression-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>expression-jexl-adapter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>expression-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>knowledge-core</artifactId>
      <!-- Pinned to the released knowledge version (0.1.0), as query-core is pinned above: the sequeless-bom import does not list it yet. -->
      <version>0.1.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>knowledge-testkit</artifactId>
      <!-- Pinned to the released knowledge version (0.1.0), as query-core is pinned above: the sequeless-bom import does not list it yet. -->
      <version>0.1.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-identity</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>ontology-core</artifactId>
      <!-- Pinned to the released ontology-core 0.2.0 (spec 18, F2). The sequeless-bom import manages 0.1.0 (G2),
           and ontology-postgres-adapter 0.1.0 compile-depends on 0.2.0. -->
      <version>0.2.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>ontology-jena-adapter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>ontology-testfixtures</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>query-core</artifactId>
      <!-- Pinned to the published query release that sequeless-bom lists (0.2.1). The sequeless-bom import below
           stays at the last released BOM, which does not list the query artifacts yet; this keeps the reactor
           resolvable before the BOM release that adds them. -->
      <version>0.2.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>query-testkit</artifactId>
      <version>0.2.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>schema-contract</artifactId>
      <!-- Pinned to the released schema-contract 0.2.0 (spec 18, F2), next to the ontology-core 0.2.0 pin: ontology-core
           0.2.0 compile-depends on it, and the sequeless-bom import manages 0.1.0. Without it,
           OntologyBomContractTest fails with NoConsistentOntologyException missing. ontology-jena-adapter 0.1.2 passes
           against 0.2.0 in this module. -->
      <version>0.2.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>store-core</artifactId>
      <!-- Pinned to the released store version (0.1.0), as query-core is pinned above: the sequeless-bom import
           does not list the store artifacts until the BOM release that adds them (spec 18, F1). -->
      <version>0.1.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>store-testkit</artifactId>
      <version>0.1.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>store-postgres-jsonb-adapter</artifactId>
      <version>0.1.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- No parent, so the GitHub Packages repository is repeated from sequeless-build-parent
       (the expression artifacts are resolved from it). Credentials come from settings.xml. -->
  <repositories>
    <repository>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/*</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-baseline</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <phase>validate</phase>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9.0,)</version>
                </requireMavenVersion>
                <dependencyConvergence/>
                <banDuplicatePomDependencyVersions/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>${maven-dependency-plugin.version}</version>
        <executions>
          <execution>
            <id>analyze-only</id>
            <goals>
              <goal>analyze-only</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <failOnWarning>true</failOnWarning>
              <ignoreNonCompile>true</ignoreNonCompile>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <palantirJavaFormat>
              <version>${palantir-java-format.version}</version>
            </palantirJavaFormat>
            <removeUnusedImports/>
            <importOrder/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
          <pom>
            <includes>
              <include>pom.xml</include>
            </includes>
            <sortPom>
              <expandEmptyElements>false</expandEmptyElements>
            </sortPom>
          </pom>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
