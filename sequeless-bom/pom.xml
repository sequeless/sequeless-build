<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.sequeless</groupId>
  <artifactId>sequeless-bom</artifactId>
  <version>0.1.4</version>
  <packaging>pom</packaging>

  <name>Sequeless BOM</name>
  <description>Bill of materials for hosts. Lists released versions only. Libraries do not import it.</description>
  <url>https://sequeless.org</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <!-- No parent: the parent never imports this BOM, so releases do not loop (#17 §6). -->
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <sequeless.github.repository>sequeless-build</sequeless.github.repository>
  </properties>

  <!-- Stage 1: the kernel and filter at their released versions (spec 5, §6; spec 6, §5). The
       ontology modules are at their released 0.1.0 (spec 11, S5a). Only released versions go
       here; bom-contracts enforces it. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>kernel-identity</artifactId>
        <version>0.1.0</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>kernel-values</artifactId>
        <version>0.1.0</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>filter-core</artifactId>
        <version>0.1.4</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>filter-sql-adapter</artifactId>
        <version>0.1.5</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>filter-sql-testkit</artifactId>
        <version>0.1.1</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>filter-sql-postgres-adapter</artifactId>
        <version>0.1.1</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>expression-api</artifactId>
        <version>0.1.1</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>expression-testkit</artifactId>
        <version>0.1.1</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>expression-jexl-adapter</artifactId>
        <version>0.1.1</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>expression-spring-boot-autoconfig</artifactId>
        <version>0.1.1</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>ontology-core</artifactId>
        <version>0.1.0</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>ontology-jena-adapter</artifactId>
        <version>0.1.0</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>schema-contract</artifactId>
        <version>0.1.0</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>behaviour-contract</artifactId>
        <version>0.1.0</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>automation-contract</artifactId>
        <version>0.1.0</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>ontology-testfixtures</artifactId>
        <version>0.1.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <repositories>
    <repository>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/*</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>

  <distributionManagement>
    <repository>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/${sequeless.github.repository}</url>
    </repository>
    <snapshotRepository>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/${sequeless.github.repository}</url>
    </snapshotRepository>
  </distributionManagement>
</project>
