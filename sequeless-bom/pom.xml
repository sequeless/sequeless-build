<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.sequeless</groupId>
  <artifactId>sequeless-bom</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Sequeless BOM</name>
  <description>Bill of materials for hosts. Lists released versions only. Libraries do not import it.</description>
  <url>https://sequeless.org</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <!-- No parent: the parent never imports this BOM, so releases do not loop (#17 §6). -->
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <sequeless.github.repository>sequeless-build</sequeless.github.repository>
  </properties>

  <!-- Stage 0 lists nothing: no Sequeless artifact is released yet. Stage 1 adds the kernel and
       filter at their released versions. Only released versions go here; bom-contracts enforces it. -->
  <dependencyManagement>
    <dependencies>
    </dependencies>
  </dependencyManagement>

  <repositories>
    <repository>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/*</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>

  <distributionManagement>
    <repository>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/${sequeless.github.repository}</url>
    </repository>
    <snapshotRepository>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/${sequeless.github.repository}</url>
    </snapshotRepository>
  </distributionManagement>
</project>
